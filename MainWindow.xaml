<Window x:Class="ExcelPagedSearchApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Paged Search (.NET 10)"
        Height="740"
        Width="1040"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="185"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: File Picker -->
        <DockPanel Grid.Row="0"
                   Margin="0,0,0,10">
            <Button x:Name="BrowseButton"
                    Content="Browse Excel..."
                    Width="120"
                    DockPanel.Dock="Right"
                    Click="BrowseButton_Click"/>
            <TextBox x:Name="FilePathTextBox"
                     IsReadOnly="True"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Row 1: Sheet, Page Size, Distributed Stride, Options -->
        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,10"
                   VerticalAlignment="Center">
            <TextBlock Text="Sheet:"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <ComboBox x:Name="SheetComboBox"
                      Width="175"
                      Margin="0,0,14,0"
                      SelectionChanged="SheetComboBox_SelectionChanged"/>

            <TextBlock Text="Rows per Page:"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <TextBox x:Name="PageSizeTextBox"
                     Text="500"
                     Width="65"
                     Margin="0,0,14,0"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Page Stride:"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       ToolTip="1 = sequential pages; >1 = distributed stride across pages"/>
            <TextBox x:Name="PageStrideTextBox"
                     Text="1"
                     Width="45"
                     Margin="0,0,14,0"
                     VerticalContentAlignment="Center"
                     ToolTip="1 = sequential pages; 4 = distributed every 4th page"/>

            <CheckBox x:Name="HasHeaderCheckBox"
                      Content="First row is header"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"
                      Checked="HeaderOption_Changed"
                      Unchecked="HeaderOption_Changed"/>
            <CheckBox x:Name="CaseSensitiveCheckBox"
                      Content="Case sensitive"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"/>
            <CheckBox x:Name="StopOnFirstMatchCheckBox"
                      Content="Stop at first match"
                      VerticalAlignment="Center"/>
        </WrapPanel>

        <!-- Row 2: Search Columns & Display Columns Selection -->
        <Grid Grid.Row="2"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Search Columns Card -->
            <GroupBox Grid.Column="0"
                      Padding="8"
                      BorderBrush="#CBD5E1"
                      Background="#F8FAFC">
                <GroupBox.Header>
                    <TextBlock x:Name="SearchColumnsHeaderText"
                               Text="Search In Columns"
                               FontWeight="SemiBold"/>
                </GroupBox.Header>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top"
                               Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Margin="6,0,0,0">
                            <Button Content="All"
                                    Width="48"
                                    Height="24"
                                    Margin="0,0,4,0"
                                    Click="SelectAllSearchCols_Click"/>
                            <Button Content="None"
                                    Width="48"
                                    Height="24"
                                    Click="ClearSearchCols_Click"/>
                        </StackPanel>
                        <TextBox x:Name="SearchColFilterTextBox"
                                 Height="24"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchColFilterTextBox_TextChanged"
                                 ToolTip="Type to filter search columns"/>
                    </DockPanel>

                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="4">
                        <ListBox x:Name="SearchColumnsListBox"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding HeaderName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="2,3"
                                              Checked="ColumnSelection_Changed"
                                              Unchecked="ColumnSelection_Changed"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Display Columns Card -->
            <GroupBox Grid.Column="2"
                      Padding="8"
                      BorderBrush="#CBD5E1"
                      Background="#F8FAFC">
                <GroupBox.Header>
                    <TextBlock x:Name="DisplayColumnsHeaderText"
                               Text="Show In Results Columns"
                               FontWeight="SemiBold"/>
                </GroupBox.Header>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top"
                               Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Margin="6,0,0,0">
                            <Button Content="All"
                                    Width="48"
                                    Height="24"
                                    Margin="0,0,4,0"
                                    Click="SelectAllDisplayCols_Click"/>
                            <Button Content="None"
                                    Width="48"
                                    Height="24"
                                    Click="ClearDisplayCols_Click"/>
                        </StackPanel>
                        <TextBox x:Name="DisplayColFilterTextBox"
                                 Height="24"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="DisplayColFilterTextBox_TextChanged"
                                 ToolTip="Type to filter result columns"/>
                    </DockPanel>

                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="4">
                        <ListBox x:Name="DisplayColumnsListBox"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding HeaderName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="2,3"
                                              Checked="ColumnSelection_Changed"
                                              Unchecked="ColumnSelection_Changed"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- Row 3: Search Input & Actions -->
        <DockPanel Grid.Row="3"
                   Margin="0,0,0,10">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="85"
                    DockPanel.Dock="Right"
                    IsEnabled="False"
                    Click="CancelButton_Click"/>
            <Button x:Name="SearchButton"
                    Content="Search Pages"
                    Width="110"
                    DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    Click="SearchButton_Click"/>
            <Button x:Name="SaveChangesButton"
                    Content="Save Changes"
                    Width="105"
                    DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    Click="SaveChangesButton_Click"/>
            <TextBox x:Name="QueryTextBox"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     KeyDown="QueryTextBox_KeyDown"/>
        </DockPanel>

        <!-- Row 4: Dynamic Results Grid -->
        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Cell Value" Click="CopyCell_Click"/>
                    <MenuItem Header="Copy Entire Row" Click="CopyRow_Click"/>
                    <MenuItem Header="Copy Selected" Click="CopySelected_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Row 5: Status Bar + Live Elapsed Seconds Counter -->
        <DockPanel Grid.Row="5"
                   Margin="0,8,0,0">
            <TextBlock x:Name="ElapsedTimerTextBlock"
                       DockPanel.Dock="Right"
                       FontWeight="SemiBold"
                       Text="Elapsed: 0s"/>
            <TextBlock x:Name="StatusTextBlock"
                       Text="Select an Excel file to begin."/>
        </DockPanel>
    </Grid>
</Window>